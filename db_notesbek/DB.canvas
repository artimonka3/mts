	"nodes":[
		{"id":"4bdb7519806d86d3","type":"text","text":"Список пользователей программы","x":-440,"y":-120,"width":250,"height":60},
		{"id":"b3400f2109f265a7","type":"text","text":"Список клиентов, с которыми были звонки","x":-440,"y":0,"width":250,"height":60,"color":"2"},
		{"id":"946fcb5119b5dfbf","type":"text","text":"Postgres SQL","x":352,"y":15,"width":145,"height":60,"color":"1"},
		{"id":"c55d3d4895127375","type":"text","text":"Струкура БД привязки summary и договорённостей к каждому звонку.","x":-80,"y":0,"width":325,"height":90,"color":"1"},
		{"id":"1b26ce9d2c118aa2","type":"text","text":"У каждого клиента есть уже собранные \"факты о клиенте.\"","x":-943,"y":75,"width":280,"height":90,"color":"3"},
		{"id":"52b6bb06e44177cd","type":"text","text":"У каждого звонка – список договорённостей","x":-46,"y":338,"width":250,"height":60,"color":"5"},
		{"id":"ab1b35a8f7d715d8","type":"text","text":"Поле языка для корректного определения","x":-440,"y":195,"width":250,"height":60},
		{"id":"2804efb2dca07738","type":"text","text":"У каждого звонка свой summary","x":-913,"y":543,"width":250,"height":60,"color":"3"},
		{"id":"d76eca922a758240","type":"text","text":"структурирования объединения реплик друг за другом.","x":-470,"y":371,"width":310,"height":65,"color":"6"},
		{"id":"6edd000c18469f05","type":"text","text":"В контексте смысла и обработки мы объединяем, но чётко разделяем слова","x":-440,"y":508,"width":250,"height":110,"color":"5"},
		{"id":"51c04cbf36269802","type":"text","text":"Все поля по договорённости","x":185,"y":443,"width":280,"height":50},
		{"id":"bb8f1172609573c0","type":"text","text":"Договорённость","x":245,"y":338,"width":160,"height":60},
		{"id":"d60aae614effbfba","type":"text","text":"Дата/сроки","x":263,"y":546,"width":125,"height":57},
		{"id":"9314fe6725860d84","x":465,"y":317,"width":265,"height":103,"color":"3","type":"text","text":"Цитаты доказательств + краткий контекст слева и справа, как три поля"},
		{"id":"3125fc04ef6438ec","type":"text","text":"Список звонков","x":-440,"y":105,"width":250,"height":60,"color":"6"},
		{"id":"81dc19703fe81e0e","type":"text","text":"Темы пользователя, для удобного поиска, классификации","x":-1160,"y":255,"width":297,"height":70},
		{"id":"2ffbb66ce27d0590","x":-1261,"y":466,"width":250,"height":160,"color":"4","type":"text","text":"На основе всех фактов + summary – свой краткий summary, чтобы не просто факты, я прям абзац монолитного, хорошо-читаемого"}
	],
