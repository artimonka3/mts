# DEVELOPMENT ONLY. These public demo values are not production secrets.
# Copy to .env for local startup; never commit .env or real credentials.
MTS_POSTGRES_DB=mts_dev
MTS_POSTGRES_USER=mts_dev
MTS_POSTGRES_PASSWORD=mts_dev_only_change_me

# Inside Compose PostgreSQL is reachable as db:5432.
# When running API/Alembic outside Docker, replace db:5432 with 127.0.0.1:55432.
MTS_DATABASE_URL=postgresql+psycopg://mts_dev:mts_dev_only_change_me@db:5432/mts_dev
MTS_ENVIRONMENT=development
MTS_DB_CONNECT_TIMEOUT_SECONDS=3
MTS_LOG_LEVEL=INFO
MTS_WORKER_POLL_SECONDS=5
MTS_API_DOCS_ENABLED=true

# JSON array. Exact origins only; cookie sessions require credentials.
MTS_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173"]
MTS_CORS_ALLOW_CREDENTIALS=true

# Run make init to generate these; preserve them on restart and during backup.
MTS_DATA_ENCRYPTION_KEY=
MTS_AUDIO_ENCRYPTION_KEY=
MTS_CRM_WEBHOOK_TOKEN=
MTS_DEMO_PASSWORD=
MTS_SESSION_COOKIE_SECURE=false
MTS_AUDIO_RETENTION_DAYS=7
MTS_TEXT_RETENTION_DAYS=30
MTS_BUSINESS_RETENTION_DAYS=365
