{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mts:fixtures:dialogues:v1",
  "title": "MTS synthetic text-only development corpus v1",
  "description": "No real audio and no ASR/LLM accuracy measurements. Cross-reference and Unicode span checks are additionally required.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "dataset_version": {
      "const": "synthetic-text-v1"
    },
    "created_on": {
      "type": "string",
      "format": "date"
    },
    "synthetic": {
      "const": true
    },
    "text_only": {
      "const": true
    },
    "no_real_audio": {
      "const": true
    },
    "measurement_status": {
      "type": "object",
      "properties": {
        "asr": {
          "const": "not_measured"
        },
        "diarization": {
          "const": "not_measured"
        },
        "llm": {
          "const": "not_measured"
        }
      },
      "required": [
        "asr",
        "diarization",
        "llm"
      ],
      "additionalProperties": false
    },
    "annotation_source": {
      "const": "codex_authored_fixture"
    },
    "human_review_status": {
      "const": "pending"
    },
    "offset_unit": {
      "const": "unicode_code_points"
    },
    "offset_convention": {
      "const": "zero_based_half_open"
    },
    "split": {
      "const": "development_only"
    },
    "warning": {
      "type": "string",
      "minLength": 1
    },
    "dialogues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dialogue"
      },
      "minItems": 20,
      "maxItems": 30
    }
  },
  "required": [
    "schema_version",
    "dataset_version",
    "created_on",
    "synthetic",
    "text_only",
    "no_real_audio",
    "measurement_status",
    "annotation_source",
    "human_review_status",
    "offset_unit",
    "offset_convention",
    "split",
    "warning",
    "dialogues"
  ],
  "additionalProperties": false,
  "$defs": {
    "evidence": {
      "type": "object",
      "properties": {
        "transcript_revision": {
          "type": "string",
          "minLength": 1
        },
        "segment_id": {
          "type": "string",
          "minLength": 1
        },
        "start_cp": {
          "type": "integer",
          "minimum": 0
        },
        "end_cp": {
          "type": "integer",
          "minimum": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1
        },
        "start_ms": {
          "type": "null"
        },
        "end_ms": {
          "type": "null"
        }
      },
      "required": [
        "transcript_revision",
        "segment_id",
        "start_cp",
        "end_cp",
        "quote",
        "start_ms",
        "end_ms"
      ],
      "additionalProperties": false
    },
    "due": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "date_only"
            },
            "timezone": {
              "const": "Europe/Minsk"
            },
            "original_text": {
              "type": [
                "string",
                "null"
              ]
            },
            "basis_call_at": {
              "type": "string",
              "format": "date-time"
            },
            "normalization_source": {
              "const": "fixture"
            },
            "ambiguous": {
              "type": "boolean"
            },
            "ambiguity_reasons": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "date": {
              "type": "string",
              "format": "date"
            }
          },
          "required": [
            "kind",
            "timezone",
            "original_text",
            "basis_call_at",
            "normalization_source",
            "ambiguous",
            "ambiguity_reasons",
            "date"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "instant"
            },
            "timezone": {
              "const": "Europe/Minsk"
            },
            "original_text": {
              "type": [
                "string",
                "null"
              ]
            },
            "basis_call_at": {
              "type": "string",
              "format": "date-time"
            },
            "normalization_source": {
              "const": "fixture"
            },
            "ambiguous": {
              "type": "boolean"
            },
            "ambiguity_reasons": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "at": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "kind",
            "timezone",
            "original_text",
            "basis_call_at",
            "normalization_source",
            "ambiguous",
            "ambiguity_reasons",
            "at"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "interval"
            },
            "timezone": {
              "const": "Europe/Minsk"
            },
            "original_text": {
              "type": [
                "string",
                "null"
              ]
            },
            "basis_call_at": {
              "type": "string",
              "format": "date-time"
            },
            "normalization_source": {
              "const": "fixture"
            },
            "ambiguous": {
              "type": "boolean"
            },
            "ambiguity_reasons": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "start": {
              "type": "string",
              "format": "date-time"
            },
            "end": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "kind",
            "timezone",
            "original_text",
            "basis_call_at",
            "normalization_source",
            "ambiguous",
            "ambiguity_reasons",
            "start",
            "end"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "unknown"
            },
            "timezone": {
              "const": "Europe/Minsk"
            },
            "original_text": {
              "type": [
                "string",
                "null"
              ]
            },
            "basis_call_at": {
              "type": "string",
              "format": "date-time"
            },
            "normalization_source": {
              "const": "fixture"
            },
            "ambiguous": {
              "type": "boolean"
            },
            "ambiguity_reasons": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          },
          "required": [
            "kind",
            "timezone",
            "original_text",
            "basis_call_at",
            "normalization_source",
            "ambiguous",
            "ambiguity_reasons"
          ],
          "additionalProperties": false
        }
      ]
    },
    "participant": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "display_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "enum": [
            "manager",
            "client",
            "other",
            "unknown"
          ]
        },
        "identity_state": {
          "enum": [
            "resolved",
            "unresolved"
          ]
        }
      },
      "required": [
        "id",
        "display_name",
        "role",
        "identity_state"
      ],
      "additionalProperties": false
    },
    "segment": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "position": {
          "type": "integer",
          "minimum": 0
        },
        "speaker_id": {
          "type": "string",
          "minLength": 1
        },
        "participant_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "start_ms": {
          "type": "null"
        },
        "end_ms": {
          "type": "null"
        }
      },
      "required": [
        "id",
        "position",
        "speaker_id",
        "participant_id",
        "text",
        "start_ms",
        "end_ms"
      ],
      "additionalProperties": false
    },
    "agreement": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "obligor_participant_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "recipient_participant_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "due": {
          "$ref": "#/$defs/due"
        },
        "condition": {
          "type": [
            "string",
            "null"
          ]
        },
        "eligibility": {
          "enum": [
            "candidate",
            "needs_review"
          ]
        },
        "needs_details": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "action",
        "obligor_participant_id",
        "recipient_participant_id",
        "due",
        "condition",
        "eligibility",
        "needs_details",
        "evidence"
      ],
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "cancelled",
            "rescheduled",
            "corrected"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 1
        }
      },
      "required": [
        "kind",
        "description",
        "evidence"
      ],
      "additionalProperties": false
    },
    "gold": {
      "type": "object",
      "properties": {
        "agreements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/agreement"
          }
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event"
          }
        },
        "key_phrases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "negative_reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "agreements",
        "events",
        "key_phrases",
        "negative_reason"
      ],
      "additionalProperties": false
    },
    "dialogue": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^syn_[0-9]{2}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "synthetic": {
          "const": true
        },
        "text_only": {
          "const": true
        },
        "no_real_audio": {
          "const": true
        },
        "usage": {
          "const": "development_fixture"
        },
        "call_at": {
          "type": "string",
          "format": "date-time"
        },
        "timezone": {
          "const": "Europe/Minsk"
        },
        "language": {
          "const": "ru"
        },
        "transcript_revision": {
          "const": "r1"
        },
        "participants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/participant"
          },
          "minItems": 1
        },
        "segments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/segment"
          },
          "minItems": 1
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "gold": {
          "$ref": "#/$defs/gold"
        }
      },
      "required": [
        "id",
        "title",
        "synthetic",
        "text_only",
        "no_real_audio",
        "usage",
        "call_at",
        "timezone",
        "language",
        "transcript_revision",
        "participants",
        "segments",
        "tags",
        "gold"
      ],
      "additionalProperties": false
    }
  }
}
